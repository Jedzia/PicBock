%% Usage: \usepackage{tradwife-einheitenwandler}

\ProvidesPackage{tradwife-einheitenwandler}[2026/10/06 Tradwife Rezepteinheiten-Konverter]
\RequirePackage{luacode}

\begin{luacode*}
local function uebersetze_einheiten(text)

    -- 1) ALLGEMEINE OCR-BEREINIGUNG: Wandelt "Zahl ... (-Zahl)" zu "Zahl-Zahl ..." um
    -- Funktioniert für "1 Teelöffel (-2)" -> "1-2 Teelföfel" und "4 sl (-8)" -> "4-8 sl"
    --- text = string.gsub(text, "(%d+)%s*([^%d%s]+)%s*%(%-(%d+)%)", "%1-%3 %2")
    text = string.gsub(text, "(%d+)%s*([^%d%s]+)%s*%(%-(%d+)%)", "%1 bis %3 %2")

    -- RICHTIGE ÜBERSETZUNG: Ersetzt "tb" oder "tbsp" (mit Leerzeichen oder ~) durch "EL"
    text = string.gsub(text, "([%d/]+)[%s~]*tbsp?", "%1 EL")
    -- Ersetzt "tb" oder "tbsp" nach einer Zahl durch "EL"
    text = string.gsub(text, "(%d+)%s*tbsp?", "%1 EL")
    -- RICHTIGE ÜBERSETZUNG: Ersetzt "tb" oder "tbsp" (mit Leerzeichen oder ~) durch "EL"
    -- text = string.gsub(text, "([%d/]+)[%s~]*tb", "%1 EL")
    text = string.gsub(text, "([%d/]+)[%s~]*tb", "%1 Esslöffel")

    -- Ersetzt "ts" oder "tsp" nach einer Zahl/einem Bruch durch "TL"
    ---- text = string.gsub(text, "(%d+)%s*tsp%s*%(%-(%d+)%)", "%1-%2 tsp")
    --- text = string.gsub(text, "([%d/]+)%s*tsp?", "%1 TL")    
    text = string.gsub(text, "([%d/]+)%s*tsp?", "%1 Teelöffel")    
    -- Ersetzt "tsp" nach einer Zahl durch "TL"
    --- text = string.gsub(text, "(%d+)%s*tsp", "%1 TL")
    text = string.gsub(text, "(%d+)%s*tsp", "%1 Teelöffel")
    -- Ersetzt "Yield:" oder "yield:"
    text = string.gsub(text, "[Yy]ield:", "Ergibt:")
    -- Ersetzt "Servings:" oder "servings:" durch "Portionen:"
    text = string.gsub(text, "[Ss]ervings", "Portionen")
    -- Ersetzt "bn" nach einer Zahl durch "Bund"
    text = string.gsub(text, "(%d+)%s*bn", "%1 Bund")
    
    text = string.gsub(text, "[Cc]ategories:", "Kategorien:")

	-- Ersetzt "ct" oder "cn" (Can) nach einer Zahl durch "Dose"
    text = string.gsub(text, "(%d+)%s*[Cc][tn]", "%1 Dose")
    -- Ersetzt das Bindewort "or" (umgeben von Leerzeichen) durch "oder"
    text = string.gsub(text, "%s+or%s+", " oder ")

    -- 1) Bereinigt das Format "4 sl (-8)" zu "4-8 sl"
---    text = string.gsub(text, "(%d+)%s*sl%s*%(%-(%d+)%)", "%1-%2 sl")
    -- 2) Ersetzt Zahlenbereiche "4-8 sl" durch "4-8 Scheiben"
---    text = string.gsub(text, "(%d+)%-(%d+)%s*sl", "%1-%2 Scheiben")
    -- 3) Ersetzt einzelne "4 sl" durch "4 Scheiben"
    text = string.gsub(text, "(%d+)%s*sl", "%1 Scheiben")
        
    -- Ersetzt "sm" nach einer Zahl durch "kleine"
    text = string.gsub(text, "(%d+)%s*[Ss]m", "%1 kleine")
    -- Ersetzt "lg" nach einer Zahl durch "große"
    text = string.gsub(text, "(%d+)%s*[Ll]g", "%1 große")

	-- Ersetzt "pn" oder "PN" (Pinch / Prise) nach einer Zahl durch "Prise"
    text = string.gsub(text, "([%d/]+)[%s~]*[Pp][Nn]", "%1 Prise")    
    

    -- AUTOMATISCHE DL-UMRECHNUNG IN ML:
    -- 1) Gemischte Brüche (z.B. "1 1/4 dl" -> 125 ml)
    text = string.gsub(text, "(%d+)%s+(%d+)/(%d+)%s*dl", function(ganz, zaehler, nenner)
        local wert = tonumber(ganz) + (tonumber(zaehler) / tonumber(nenner))
        return string.format("%g ml", wert * 100)
    end)
    
    -- 2) Reine Brüche (z.B. "1/2 dl" -> 50 ml)
    text = string.gsub(text, "(%d+)/(%d+)%s*dl", function(zaehler, nenner)
        local wert = tonumber(zaehler) / tonumber(nenner)
        return string.format("%g ml", wert * 100)
    end)
    
    -- 3) Ganze Zahlen und Dezimalzahlen (z.B. "2 dl" -> 200 ml, "1.5 dl" -> 150 ml)
    text = string.gsub(text, "(%d+%.?%d*)%s*dl", function(zahl)
        local wert = tonumber(zahl)
        return string.format("%g ml", wert * 100)
    end)    
  
    
-- Deutsche Transkriptionen
    -- Ersetzt "pkt" oder "Pkt" (Paket/Packung) nach einer Zahl durch "Paket"
    text = string.gsub(text, "([%d/]+)%s*[Pp]kt", "%1 Paket")
	-- Ersetzt "el" oder "EL" nach einer Zahl/einem Bruch durch "Esslöffel"
    text = string.gsub(text, "([%d/]+)[%s~]*[Ee][Ll]", "%1 Esslöffel")
	-- Ersetzt "tl" oder "TL" nach einer Zahl/einem Bruch durch "Teelöffel"
    text = string.gsub(text, "([%d/]+)[%s~]*[Tt][Ll]", "%1 Teelöffel")


 -- Ersetzt "Title: " oder "title: " (inklusive des Leerzeichens danach) durch nichts
    text = string.gsub(text, "[Tt]itle:%s*", "")




-- Funktion zur Erkennung des richtigen Artikels basierend auf dem Folgewort
    -- Definieren der Wortliste außerhalb, um Code sauber zu halten
    local feminine_woerter = {
        zwiebel=true, zitronen=true, zitrone=true, tomate=true, 
        gurke=true, zehe=true, stange=true, prise=true, dose=true,
        knoblauchzehe=true, handvoll=true, messerspitze=true
    }

    -- Hilfsfunktion für die Ersetzung
    local function bestimme_artikel(vorzeichen, wort)
        local wort_klein = string.lower(wort)
        if feminine_woerter[wort_klein] then
            return vorzeichen .. "Eine " .. wort
        else
            return vorzeichen .. "Ein " .. wort
        end
    end

    -- 1) Fall: "1 Zwiebel" mitten im Text (nach einem Leerzeichen oder einer Klammer)
    text = string.gsub(text, "([^%w/])1%s+([^%d%s]+)", function(vorzeichen, wort)
        return bestimme_artikel(vorzeichen, wort)
    end)

    -- 2) Fall: "1 Zwiebel" steht ganz am Anfang der Zeile
    text = string.gsub(text, "^1%s+([^%d%s]+)", function(wort)
        return bestimme_artikel("", wort)
    end)



 -- 6) SICHERE UMLAUT-KONVERTIERUNG (Ignoriert LaTeX-Systembefehle)
    -- Wir ersetzen nur, wenn KEIN Backslash, Punkt oder Doppelpunkt direkt vor dem Wort steht
    
    -- Kleinbuchstaben
    text = string.gsub(text, "([^\\%.:%a])wuerzsud", "%1würzsud") -- Spezifischer Schutz für dein Hauptwort
    text = string.gsub(text, "([^\\%.:%a])ae", "%1ä")
    text = string.gsub(text, "([^\\%.:%a])oe", "%1ö")
    
    -- "ue" wird hier besonders geschützt, damit ".value" oder "\value" ganz bleiben
    text = string.gsub(text, "([^\\%.:%a_])ue", "%1ü")

    -- Großbuchstaben
    text = string.gsub(text, "([^\\%.:%a])Ae", "%1Ä")
    text = string.gsub(text, "([^\\%.:%a])Oe", "%1Ö")
    text = string.gsub(text, "([^\\%.:%a])Ue", "%1Ü")

    return text
end

luatexbase.add_to_callback("process_input_buffer", uebersetze_einheiten, "TradwifeEinheitenUebersetzer")
\end{luacode*}
